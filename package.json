{
  "name": "vectemporel-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vectemporel — atlas hiérarchique vérifié, généré depuis les audits locaux.",
  "scripts": {
    "build:data": "node scripts/build-dataset.mjs",
    "start": "node scripts/serve.mjs",
    "verify": "node scripts/verify.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "check": "npm run verify && npm run check:tokens && npm run verify:points && npm run check:imports && npm run test:e2e && npm run test:guards && npm run test:coverage-guard && npm run test:idempotence && npm run test:perf",
    "verify:points": "node scripts/verify-points.mjs",
    "report:coverage": "node scripts/report-coverage.mjs",
    "build:points": "node scripts/merge-points.mjs && npm run verify:points",
    "test:guards": "node tests/http-guards.mjs",
    "test:idempotence": "node tests/build-idempotence.mjs",
    "test:coverage-guard": "node tests/verify-points-guard.mjs",
    "test:perf": "node tests/perf-budget.mjs",
    "test:pwa": "node tests/pwa.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "capture:all": "node scripts/capture-all.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "report:omissions": "node scripts/report-omissions.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "puppeteer-core": "25.18.1",
    "yaml": "2.9.1"
  }
}
