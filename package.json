{
  "name": "vectemporel-history-poc",
  "version": "0.2.0",
  "private": true,
  "description": "Vectemporel — POC de frise historique zoomable, pays par pays, avec filtres par tags et lecteur Grokipedia traduit en français.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build:atlas": "node scripts/build-atlas.mjs",
    "build:globe": "node scripts/build-globe-textures.mjs",
    "audit:timeline": "node scripts/audit-timeline.mjs",
    "audit:timeline:strict": "node scripts/audit-timeline.mjs --strict",
    "audit:dossiers": "node scripts/check-audit-dossiers.mjs",
    "verify": "node scripts/verify-grok.mjs",
    "verify:sources": "node scripts/verify-sources.mjs",
    "apply:fixes": "node scripts/apply-country-fixes.mjs",
    "apply:fixes:dry": "node scripts/apply-country-fixes.mjs --dry-run",
    "build:spiral-meta": "node scripts/build-spiral-meta.mjs",
    "build:event-images": "node scripts/build-event-images.mjs",
    "build:images:all": "npm run build:event-images && node scripts/fetch-wiki-images.mjs && node scripts/fetch-search-images.mjs && node scripts/optimize-images.mjs",
    "build:places": "node scripts/build-place-atlas.mjs",
    "test:e2e": "node scripts/e2e-keyboard.mjs",
    "verify:all": "npm run audit:timeline && npm run audit:dossiers && npm run verify:sources && npm run test:e2e"
  },
  "keywords": [
    "histoire",
    "timeline",
    "grokipedia",
    "poc",
    "dataviz"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "d3-geo": "^3.1.2",
    "puppeteer-core": "^23.11.1",
    "three": "^0.152.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
