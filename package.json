{
  "name": "vectemporel-atlas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Atlas historique mondial local — carte vectorielle clean-room à partir des données Chronas (CC BY-SA 4.0).",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "map:data": "node scripts/import-chronas-map.mjs",
    "years:import": "node scripts/import-chronas-years.mjs",
    "cities:import": "node scripts/import-chronas-markers.mjs",
    "labels:import": "node scripts/import-chronas-metadata.mjs",
    "epics:import": "node scripts/import-chronas-epics.mjs",
    "provinces:import": "node scripts/import-chronas-province-timelines.mjs",
    "modern:import": "node scripts/import-modern-labels.mjs",
    "three:build": "node scripts/build-three.mjs",
    "prebuild:pages": "npm run three:build",
    "test:years": "node tests/year-integrity.mjs",
    "test:vector": "node tests/vector-provinces.mjs",
    "test:provinces": "node tests/province-timelines.mjs",
    "test:learning": "node tests/learning.mjs",
    "test:scale": "node tests/timeline-scale.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "verify": "node scripts/verify.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:perf": "node tests/perf-budget.mjs",
    "test:pwa": "node tests/pwa.mjs",
    "check": "npm run verify && npm run test:years && npm run test:scale && npm run test:vector && npm run test:provinces && npm run test:learning && node tests/http-guards.mjs && npm run test:live && npm run test:e2e && npm run test:perf && npm run test:pwa && npm run test:devtools",
    "test:devtools": "node tests/devtools-bridge.mjs",
    "test:live": "node tests/live-layout.mjs",
    "bridge:check": "node tests/bridge-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "puppeteer-core": "25.18.1",
    "three": "^0.180.0",
    "threejs-devtools-mcp": "0.5.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
